# Groq API - used to generate the Hebrew Israeli-market analysis
GROQ_API_KEY=your_groq_api_key_here

# Optional model override
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=90

# Keep TASE request concurrency conservative to avoid rate limiting
TASE_MAX_WORKERS=3
TASE_STOCK_WORKERS=3

# Historical graphs are downloaded in full once, refreshed incrementally each
# day, and reconciled with a full refresh weekly.
TASE_HISTORY_CACHE=1
TASE_HISTORY_FULL_REFRESH_DAYS=7
# Retain verified observations as the one-year endpoint refreshes, allowing the
# recommendation backtest to grow toward five years without extra daily calls.
TASE_HISTORY_RETENTION_DAYS=1830
# In production, keep the cache beside the persistent database.
FINANCIAL_BRIEF_CACHE_DIR=/var/lib/financialbrief/market-cache

# Gmail settings - use an App Password (not your real password)
# Enable at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Your name and email — auto-added to subscriber DB on first run
OWNER_NAME=Your Name
OWNER_EMAIL=your_email@gmail.com

# Public URL of your server (used for unsubscribe links in emails)
# With nginx path routing, this keeps the root URL available for other systems.
BASE_URL=http://YOUR_SERVER_IP/financialbrief

# Internal signup app port. Keep this separate from other systems on the same server.
APP_PORT=5001

# Production database path. Keep this outside the Git/code directory so deploys
# cannot overwrite subscriber data.
FINANCIAL_BRIEF_DB_PATH=/var/lib/financialbrief/subscribers.db

# V2 starts in shadow mode. "auto" permits promotion only after at least 60
# matured live forecasts and better out-of-sample results than V1.
RECOMMENDATION_V2_MODE=shadow

# Random secret string for Flask session security
FLASK_SECRET=pick_a_long_random_string_here
