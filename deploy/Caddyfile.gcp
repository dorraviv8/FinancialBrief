{$PUBLIC_HOST} {
  encode zstd gzip

  redir /financialbrief /financialbrief/ 308

  handle_path /financialbrief/* {
    reverse_proxy 172.18.0.1:5001 {
      header_up X-Forwarded-Prefix /financialbrief
    }
  }

  @metrics path /metrics
  respond @metrics 404

  @grafana path /grafana /grafana/*
  reverse_proxy @grafana grafana:3000

  reverse_proxy trader-helper:5173 {
    health_uri /health
    health_interval 30s
  }
}
