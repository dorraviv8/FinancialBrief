[Unit]
Description=Retry preparation and QA of the Israeli market morning briefing
After=network-online.target financial-brief.service
Wants=network-online.target

[Service]
Type=oneshot
# Leave a safety margin before the fixed 08:00 delivery job.
TimeoutStartSec=4min
TimeoutStopSec=10s
User=YOUR_GCP_USER
WorkingDirectory=/opt/financialbrief
EnvironmentFile=/etc/financialbrief.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/financialbrief/fin_env/bin/python /opt/financialbrief/financial_brief.py --prepare

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/financialbrief

[Install]
WantedBy=multi-user.target
