[Unit]
Description=Send today's QA-approved Israeli market briefing
After=network-online.target financial-brief.service financial-brief-retry.service
Wants=network-online.target

[Service]
Type=oneshot
User=YOUR_GCP_USER
WorkingDirectory=/opt/financialbrief
EnvironmentFile=/etc/financialbrief.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/financialbrief/fin_env/bin/python /opt/financialbrief/financial_brief.py --send-prepared

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/financialbrief
