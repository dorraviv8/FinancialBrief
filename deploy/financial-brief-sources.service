[Unit]
Description=Collect Israeli weekly-report news and FX sources
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=YOUR_GCP_USER
WorkingDirectory=/opt/financialbrief
EnvironmentFile=/etc/financialbrief.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/financialbrief/fin_env/bin/python /opt/financialbrief/gather_weekly_sources.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/financialbrief

