[Unit]
Description=FinancialBrief signup and unsubscribe web app
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_GCP_USER
WorkingDirectory=/opt/financialbrief
EnvironmentFile=/etc/financialbrief.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/financialbrief/fin_env/bin/gunicorn --workers 2 --bind 172.18.0.1:5001 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/financialbrief

[Install]
WantedBy=multi-user.target
